/*
 * Rofi — тёмная тема «Graphite» (лёгкая версия)
 * Непрозрачный фон, компактные размеры, без стекла/блюра.
 */

* {
    /* ── Палитра (графит + серый акцент) ─────────────────── */
    bg:         #181818;   /* непрозрачный — никакого стекла */
    bg-alt:     #242424;
    fg:         #e6e6e6;
    fg-muted:   #7d7d7d;
    accent:     #9a9a9a;
    accent-dim: #2e2e2e;
    urgent:     #c26a6a;

    /* Приглушённые акценты (палитра из foot/kitty) */
    steel:  #8296b8;   /* сине-серый — строка поиска, выбор */
    sel:    #2e2e2e;   /* подложка выбранного элемента (серая) */
    border: #454e5a;   /* рамка с лёгкой синевой */

    /* ── Базовые настройки ───────────────────────────────── */
    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 10";
    spacing:          0;
    margin:           0;
    padding:          0;
    border:           0;
}

/* ── Окно ─────────────────────────────────────────────── */
window {
    width:            420px;
    padding:          10px;
    border:           1px;
    border-color:     @border;
    border-radius:    8px;
    background-color: @bg;
    location:         center;
    anchor:           center;
}

mainbox {
    children: [inputbar, listview];
    spacing:  8px;
}

/* ── Строка поиска ────────────────────────────────────── */
inputbar {
    children:         [prompt, entry];
    background-color: @bg-alt;
    border-radius:    6px;
    padding:          8px 10px;
    spacing:          8px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder:       "Поиск…";
    placeholder-color: @fg-muted;
    cursor:            text;
}

/* ── Список ───────────────────────────────────────────── */
listview {
    lines:     6;
    spacing:   2px;
    scrollbar: false;
    fixed-height: false;
    background-color: transparent;
}

element {
    padding: 6px 8px;
    spacing: 8px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @sel;
    text-color:       @fg;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @bg;
}

element-icon {
    size: 18px;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
    vertical-align:   0.5;
}

/* ── Сообщение под списком (ошибки и т.п.) ────────────── */
message {
    background-color: @bg-alt;
    padding:          6px 10px;
    text-color:       @fg-muted;
}
